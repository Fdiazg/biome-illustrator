{
  "name": "biome-illustrator",
  "version": "0.3.0",
  "description": "Generative SVG illustration engine, deterministic by seed: plants, trees, clouds and landscapes with a hand-drawn pen stroke.",
  "keywords": [
    "svg",
    "generative",
    "generative-art",
    "illustration",
    "procedural",
    "seed",
    "deterministic",
    "botanical",
    "react"
  ],
  "license": "MIT",
  "author": "Felipe Diaz (https://github.com/Fdiazg)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fdiazg/biome-illustrator.git"
  },
  "homepage": "https://github.com/Fdiazg/biome-illustrator#readme",
  "bugs": {
    "url": "https://github.com/Fdiazg/biome-illustrator/issues"
  },
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@12.14.0",
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:lib && pnpm run build:site",
    "build:lib": "tsup",
    "build:site": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "export": "tsx scripts/export.ts",
    "audit": "tsx scripts/audit.ts",
    "sheet": "tsx scripts/sheet.ts",
    "png": "tsx scripts/png.ts",
    "typecheck": "tsc --noEmit",
    "snapshot": "tsx scripts/snapshot.ts",
    "prepublishOnly": "pnpm run typecheck && pnpm run audit && pnpm run snapshot && pnpm run build:lib",
    "gallery": "tsx scripts/gallery.ts",
    "review": "tsx scripts/review.ts",
    "review:sprig": "tsx scripts/review-sprig.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
